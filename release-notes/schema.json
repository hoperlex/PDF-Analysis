{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository release note entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "revision", "date", "title", "items"],
  "properties": {
    "version": {"type": "string", "minLength": 5},
    "revision": {"type": "integer", "minimum": 1},
    "date": {"type": "string", "format": "date"},
    "title": {"type": "string", "minLength": 1},
    "is_archive": {"type": "boolean"},
    "range_label": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "kind": {"type": "string", "enum": ["new", "improved", "fixed"]},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "screen", "where", "text"],
      "properties": {
        "kind": {"$ref": "#/$defs/kind"},
        "screen": {"type": "string", "minLength": 1},
        "where": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}

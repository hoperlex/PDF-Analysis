# PC-01 web shell environment. Disposable values only: nothing here is a secret, and
# nothing here reaches object storage. The web tier never holds an S3 endpoint, an
# access key or a database URL — it speaks to the API and to nothing else.
#
# Copy to `web/.env.local` (git-ignored) before `npm run dev`.

# Required. The versioned API base path or absolute origin. There is deliberately no
# localhost default in code: a missing value fails loudly at first use rather than
# silently pointing a build at a developer's laptop.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Optional. Label shown in the shell header so an operator can tell two local
# instances apart. Cosmetic only; authorizes nothing.
NEXT_PUBLIC_INSTANCE_LABEL=local

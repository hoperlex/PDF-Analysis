{
  "name": "auditmanager-web",
  "version": "0.1.0",
  "private": true,
  "description": "PC-01 web shell, shared layer and generated API client. Product screens belong to B7/B8.",
  "license": "LicenseRef-Proprietary",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "api:generate": "node scripts/generate-api-client.mjs",
    "api:verify": "node scripts/generate-api-client.mjs --check",
    "test": "vitest run",
    "test:guards": "vitest run tests/guards",
    "test:contract": "vitest run tests/contract",
    "test:unit": "node scripts/reserved-forwarder.mjs test:unit",
    "e2e:pc01": "node ../tests/e2e/pc01/journey/journey.mjs",
    "csv:verify": "node scripts/reserved-forwarder.mjs csv:verify"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditmanager:fixtures:golden-journey-manifest:v1",
  "title": "Golden journey manifest v1",
  "description": "Structural schema for a single selected golden journey manifest produced by W0-BHV-02. Fixture-local: it is not a ratified repository contract and freezes no product semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journey_id",
    "title",
    "summary",
    "inventory_candidates",
    "comparison_mode",
    "determinism",
    "provenance",
    "input_manifest",
    "expected_outputs",
    "failure_cases",
    "sensitive_data_exclusions",
    "reviewer_sampling"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "journey_id": {
      "$ref": "#/$defs/selected_journey_id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "inventory_candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/inventory_candidate_id"
      }
    },
    "comparison_mode": {
      "enum": [
        "exact",
        "semantic",
        "replay"
      ]
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_dependent",
        "llm_text_equality_asserted",
        "rationale"
      ],
      "properties": {
        "provider_dependent": {
          "type": "boolean"
        },
        "llm_text_equality_asserted": {
          "const": false
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "replay_material": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "review_status",
              "content_policy"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/repo_relative_path"
              },
              "review_status": {
                "const": "reviewed_for_sensitive_content"
              },
              "content_policy": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_source_commit",
        "method",
        "data_classification",
        "inventory_reference",
        "runtime_execution",
        "evidence"
      ],
      "properties": {
        "legacy_source_commit": {
          "const": "32b9d903792b30506048a1d42b0e6b2d07aee403"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "data_classification": {
          "enum": [
            "synthetic",
            "anonymized"
          ]
        },
        "inventory_reference": {
          "$ref": "#/$defs/repo_relative_path"
        },
        "runtime_execution": {
          "const": "none"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability_id",
              "source_ref",
              "evidence_class",
              "supports"
            ],
            "properties": {
              "capability_id": {
                "type": "string",
                "pattern": "^(WS|AN|FD|EX|CP|OUT|LO|DW)-[0-9]{2}$"
              },
              "source_ref": {
                "$ref": "#/$defs/legacy_source_ref"
              },
              "evidence_class": {
                "enum": [
                  "direct",
                  "inferred"
                ]
              },
              "supports": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "input_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_classification",
        "generation_method",
        "artifacts"
      ],
      "properties": {
        "data_classification": {
          "enum": [
            "synthetic",
            "anonymized"
          ]
        },
        "generation_method": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role",
              "media_type",
              "sha256",
              "size_bytes",
              "data_classification"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/repo_relative_path"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "media_type": {
                "enum": [
                  "application/json",
                  "text/plain",
                  "text/markdown"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "data_classification": {
                "enum": [
                  "synthetic",
                  "anonymized"
                ]
              }
            }
          }
        },
        "surrogates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "legacy_input_kind",
              "surrogate",
              "reason"
            ],
            "properties": {
              "legacy_input_kind": {
                "type": "string",
                "minLength": 1
              },
              "surrogate": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/expectation"
      }
    },
    "failure_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/failure_case"
      }
    },
    "sensitive_data_exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "excluded",
          "reason"
        ],
        "properties": {
          "excluded": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviewer_sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_evidence_objects",
        "instruction"
      ],
      "properties": {
        "minimum_evidence_objects": {
          "type": "integer",
          "minimum": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "selected_journey_id": {
      "enum": [
        "GJ-01",
        "GJ-02",
        "GJ-03",
        "GJ-04",
        "GJ-05"
      ]
    },
    "inventory_candidate_id": {
      "type": "string",
      "pattern": "^GJ-(0[1-9]|1[01])$"
    },
    "repo_relative_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "legacy_source_ref": {
      "type": "string",
      "pattern": "^32b9d903792b30506048a1d42b0e6b2d07aee403:[A-Za-z0-9][A-Za-z0-9._/-]*:[A-Za-z0-9_]+@[0-9]+(-[0-9]+)?$"
    },
    "owner_decision_id": {
      "enum": [
        "PD-01",
        "PD-02",
        "PD-03",
        "PD-04"
      ]
    },
    "provenance_class": {
      "enum": [
        "legacy_observed",
        "greenfield_target",
        "pending_owner_decision"
      ]
    },
    "provenance_class_rules": {
      "allOf": [
        {
          "if": {
            "required": [
              "provenance_class"
            ],
            "properties": {
              "provenance_class": {
                "const": "legacy_observed"
              }
            }
          },
          "then": {
            "required": [
              "legacy_evidence_refs"
            ],
            "properties": {
              "parity_oracle": {
                "const": true
              },
              "legacy_evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "provenance_class"
            ],
            "properties": {
              "provenance_class": {
                "const": "greenfield_target"
              }
            }
          },
          "then": {
            "required": [
              "target_basis"
            ],
            "properties": {
              "parity_oracle": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "provenance_class"
            ],
            "properties": {
              "provenance_class": {
                "const": "pending_owner_decision"
              }
            }
          },
          "then": {
            "required": [
              "owner_decision_ref",
              "target_basis"
            ],
            "properties": {
              "parity_oracle": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "authority"
            ]
          },
          "then": {
            "properties": {
              "provenance_class": {
                "not": {
                  "const": "legacy_observed"
                }
              },
              "parity_oracle": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provenance_class",
        "assertion_kind",
        "statement",
        "parity_oracle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GJ-0[1-5]-EO-[0-9]{2}$"
        },
        "provenance_class": {
          "$ref": "#/$defs/provenance_class"
        },
        "assertion_kind": {
          "enum": [
            "structural",
            "state_transition",
            "status_code",
            "artifact_presence",
            "identity",
            "ordering",
            "idempotency",
            "invariant",
            "bounded_absence"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "parity_oracle": {
          "type": "boolean"
        },
        "legacy_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legacy_source_ref"
          }
        },
        "target_basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_decision_ref": {
          "$ref": "#/$defs/owner_decision_id"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        }
      },
      "$ref": "#/$defs/provenance_class_rules"
    },
    "failure_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provenance_class",
        "trigger",
        "expected_visible_state",
        "silent_fallback_allowed",
        "parity_oracle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GJ-0[1-5]-FC-[0-9]{2}$"
        },
        "provenance_class": {
          "$ref": "#/$defs/provenance_class"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "expected_visible_state": {
          "type": "string",
          "minLength": 1
        },
        "silent_fallback_allowed": {
          "const": false
        },
        "parity_oracle": {
          "type": "boolean"
        },
        "legacy_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legacy_source_ref"
          }
        },
        "target_basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_decision_ref": {
          "$ref": "#/$defs/owner_decision_id"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        }
      },
      "$ref": "#/$defs/provenance_class_rules"
    },
    "authority": {
      "type": "object",
      "description": "Non-legacy, non-owner source from which a target value is reported verbatim. It exists so that an expectation can name where a target value comes from instead of asserting the rule in its own name. It is never legacy evidence: legacy evidence lives in legacy_evidence_refs and must resolve at the pinned legacy commit.",
      "additionalProperties": false,
      "required": [
        "authority_kind",
        "contract",
        "contract_version",
        "source_path",
        "selector",
        "value",
        "freeze_status",
        "read_scope",
        "provenance_note"
      ],
      "properties": {
        "authority_kind": {
          "enum": [
            "contract_registry_field"
          ]
        },
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "$ref": "#/$defs/repo_relative_path"
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "boolean",
            "string",
            "number"
          ]
        },
        "freeze_status": {
          "enum": [
            "unfrozen_candidate"
          ]
        },
        "read_scope": {
          "type": "string",
          "minLength": 1
        },
        "provenance_note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

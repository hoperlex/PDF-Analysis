{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditmanager:analysis:stage-result:v1",
  "title": "StageResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_name",
    "stage_version",
    "status",
    "artifacts",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage_name": {
      "type": "string",
      "minLength": 1
    },
    "stage_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "skipped"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "blob_id",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "blob_id": {
            "type": "string",
            "pattern": "^blob_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "logical_name": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditmanager:analysis:job-package:v1",
  "title": "JobPackage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "attempt_id",
    "run_id",
    "version_uid",
    "analysis_profile_id",
    "artifacts",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "version_uid": {
      "type": "string",
      "pattern": "^ver_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "analysis_profile_id": {
      "type": "string",
      "pattern": "^ap_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "fencing_token": {
      "type": [
        "string",
        "integer"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "blob_id",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "blob_id": {
            "type": "string",
            "pattern": "^blob_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "logical_name": {
            "type": "string"
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "config_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}

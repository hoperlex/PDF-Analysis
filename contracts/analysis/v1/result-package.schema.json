{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditmanager:analysis:result-package:v1",
  "title": "ResultPackage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "attempt_id",
    "run_id",
    "stage_results",
    "usage_summary",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "fencing_token": {
      "type": [
        "string",
        "integer"
      ]
    },
    "stage_results": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:auditmanager:analysis:stage-result:v1",
        "title": "StageResult v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "stage_name",
          "stage_version",
          "status",
          "artifacts",
          "metrics"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "stage_name": {
            "type": "string",
            "minLength": 1
          },
          "stage_version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "succeeded",
              "partial",
              "failed",
              "skipped"
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "blob_id",
                "sha256",
                "size_bytes",
                "media_type"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "blob_id": {
                  "type": "string",
                  "pattern": "^blob_[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "media_type": {
                  "type": "string",
                  "minLength": 1
                },
                "logical_name": {
                  "type": "string"
                }
              }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "integer",
                "string",
                "boolean",
                "null"
              ]
            }
          },
          "error_code": {
            "type": "string"
          },
          "error_message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    },
    "usage_summary": {
      "type": "object",
      "properties": {
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

            "published",
            "partial",
            "failed"
          ]
        },
        "terminal_forbidden": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "published",
              "partial",
              "failed",
              "cancelled"
            ]
          }
        },
        "on_violation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "description": "A row that forbids a terminal must name the code reported when it is attempted. A forbidding row without a code would be an untyped refusal.",
          "if": {
            "properties": {
              "terminal_forbidden": {
                "minItems": 1
              }
            },
            "required": [
              "terminal_forbidden"
            ]
          },
          "then": {
            "required": [
              "on_violation"
            ]
          }
        }
      ]
    },
    "outcomeValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successful",
        "typed_reason",
        "description"
      ],
      "properties": {
        "successful": {
          "type": "boolean"
        },
        "typed_reason": {
          "enum": [
            "required",
            "forbidden"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }

  "allOf": [
    {
      "description": "audit_run must declare run_creation: PD-03 as approved with modification requires the AuditRun creation rule to be machine-readable, not prose.",
      "properties": {
        "machines": {
          "properties": {
            "audit_run": {
              "type": "object",
              "required": [
                "run_creation"
              ]
            }
          }
        }
      }
    },
    {
      "description": "machines.audit_run must keep the guard that makes validating -> published unavailable while an admitted optional branch is unsuccessful. Removing it would leave the rule stated only in optional_branch_policy and reachable in the machine.",
      "properties": {
        "machines": {
          "properties": {
            "audit_run": {
              "type": "object",
              "properties": {
                "guards": {
                  "contains": {
                    "type": "object",
                    "required": [
                      "from",
                      "to",
                      "on_violation"
                    ],
                    "properties": {
                      "from": {
                        "const": "validating"
                      },
                      "to": {
                        "const": "published"
                      },
                      "on_violation": {
                        "const": "partial_result_not_publishable"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "machines.job must keep the guard that refuses a published result declaring success while an admitted optional branch is unsuccessful.",
      "properties": {
        "machines": {
          "properties": {
            "job": {
              "type": "object",
              "properties": {
                "guards": {
                  "contains": {
                    "type": "object",
                    "required": [
                      "from",
                      "to",
                      "on_violation"
                    ],
                    "properties": {
                      "from": {
                        "const": "running"
                      },
                      "to": {
                        "const": "succeeded"
                      },
                      "on_violation": {
                        "const": "partial_result_not_publishable"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "terminalSelectionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_terminal",
        "branch_status",
        "terminal",
        "terminal_forbidden"
      ],
      "properties": {
        "core_terminal": {
          "enum": [
            "published",
            "partial",
            "failed"
          ]
        },
        "branch_status": {
          "enum": [
            "all_successful",
            "any_unsuccessful"

# `FIRST-INSTALL-03`: look at origin/main every five minutes (the service does nothing when it has not moved). `Persistent=true`: a look that
# was due while the server was off is made at boot. Written to /etc/systemd/system by `infra/deploy/first-install.sh`; disabled by it when
# the installation is switched to `--deploy-mode github`.
[Unit]
Description=AuditManager @INSTANCE@: look at origin/main every five minutes (deploy-local.sh --if-moved)

[Timer]
OnCalendar=*:0/5
Persistent=true
AccuracySec=30s
Unit=@INSTANCE@-deploy-local.service

[Install]
WantedBy=timers.target

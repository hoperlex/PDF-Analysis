# The web image: the PC-01 shell, built by `npm run build` and served by `next start`.
#
# `NEXT_PUBLIC_API_BASE_URL` is a BUILD argument, not a runtime one, and that is a fact
# about Next and not a choice made here: `web/src/shared/config/env.ts` reads
# `process.env.NEXT_PUBLIC_API_BASE_URL`, and Next inlines every `NEXT_PUBLIC_*` reference
# into the browser bundle at build time. Its own comment says as much -- "NEXT_PUBLIC_*
# values are compiled into the browser bundle, so anything placed here is public by
# construction".
#
# `T-2` is what makes that harmless. The value is `/api/v1`, a RELATIVE path, so the
# bundle names no origin: the same image works behind any host the proxy answers on, and
# there is no cross-origin surface to configure or mis-configure. An absolute origin baked
# here would tie the image to one deployment and put a CORS surface on a frozen contract.
#
# `npm ci`, never `npm install`: `web/package-lock.json` is the authority and a build may
# not resolve anything.

# node:24-bookworm-slim, resolved 2026-09-18. `web/FRONTEND_LOCK.json` records the
# frontend toolchain; the digest is pinned here for the same reason the API base is.
FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS build

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./

ARG NEXT_PUBLIC_API_BASE_URL=/api/v1
ARG NEXT_PUBLIC_INSTANCE_LABEL=alpha
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_INSTANCE_LABEL=$NEXT_PUBLIC_INSTANCE_LABEL \
    NEXT_TELEMETRY_DISABLED=1
# The build is the type gate too: `next.config.mjs` sets `ignoreBuildErrors: false`, so a
# type error is a failed image rather than a shipped one.
RUN npm run build

FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

RUN apt-get update \
 && apt-get install --no-install-recommends --yes curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /web
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0

# The whole tree, because `next start` needs `node_modules`, `.next`, `package.json` and
# `next.config.mjs`. A leaner `output: "standalone"` build would halve this, and it is NOT
# done here: that switch lives in `web/next.config.mjs`, which `W14-PKG` does not own.
# Recorded in docs/program/reviews/W14-PKG.md as a measured, deliberate cost.
COPY --from=build /web /web

USER node
EXPOSE 3000

CMD ["npm", "run", "start"]
